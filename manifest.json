{
  "manifest_version": 3,
  "name": "ORACLE",
  "version": "1.3.0",
  "description": "A private Chromium browser companion with local page tools and optional WebGPU-powered AI. No paid API keys or AI servers.",
  "minimum_chrome_version": "113",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "ORACLE",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "dictionary.js",
        "dictionary-full.js",
        "engine.js",
        "storage.js",
        "palette.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open the ORACLE command palette on this page"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Open the ORACLE popup"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self' https://huggingface.co https://*.huggingface.co https://raw.githubusercontent.com https://*.xethub.hf.co https://hf.co https://*.hf.co https://cas-server.xethub-eu.hf.co https://transfer.xethub-eu.hf.co https://us.aws.cdn.hf.co https://us.gcp.cdn.hf.co https://cdn-lfs-us-1.hf.co https://cdn-lfs-eu-1.hf.co"
  },
  "host_permissions": [
    "https://en-word.net/*",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://raw.githubusercontent.com/*",
    "https://*.xethub.hf.co/*",
    "https://hf.co/*",
    "https://*.hf.co/*",
    "https://cas-server.xethub-eu.hf.co/*",
    "https://transfer.xethub-eu.hf.co/*",
    "https://us.aws.cdn.hf.co/*",
    "https://us.gcp.cdn.hf.co/*",
    "https://cdn-lfs-us-1.hf.co/*",
    "https://cdn-lfs-eu-1.hf.co/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dictionary-data/*.json.gz",
        "dictionary-data/metadata.json"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
